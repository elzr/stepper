{
  "vars": {  // set weekly by L005; git stores them blanked as NN/DAYS (.gitattributes)
    "weekNum": "NN",                   // current
    "weekDays": "DAYS",

    "pastWeekNum": "NN",              // R⌘ (right-cmd)
    "pastWeekDays": "DAYS",     // R⌘ (right-cmd)

    "nextWeekNum": "NN",              // R⌥ (right-option)
    "nextWeekDays": "DAYS"    // R⌥ (right-option)
  },
  // run ~/bin/hs-reload.sh to reload after editing
  "mods": ["ctrl", "alt", "shift", "cmd"],
  "notes": [
    {"key": "N", "action": "open-bear-note", "title": "_mem NOW"},
    {"key": "D", "action": "open-bear-note", "title": "w${weekNum}days ${weekDays}", "pastTitle": "w${pastWeekNum}days ${pastWeekDays}", "nextTitle": "w${nextWeekNum}days ${nextWeekDays}"},
    {"key": "W", "action": "open-bear-note", "title": "w${weekNum}work ${weekDays}", "pastTitle": "w${pastWeekNum}work ${pastWeekDays}", "nextTitle": "w${nextWeekNum}work ${nextWeekDays}"},
    {"key": "T", "action": "open-bear-note", "title": "w${weekNum}thoughts ${weekDays}", "pastTitle": "w${pastWeekNum}thoughts ${pastWeekDays}", "nextTitle": "w${nextWeekNum}thoughts ${nextWeekDays}"}
  ],
  "urls": [
    {"key": "F", "url": "raycast://extensions/sara/featurebase/index"}
  ],
  // Live window slots, bound in bear-hud.lua: R⌥◆key gives one the focused window, ◆key toggles it,
  // R⇧◆key summons it. Every ◆ letter and digit not taken above or by BTT (◆1–5); a note or URL key
  // listed here stays a note or URL.
  // I, M, R and S were fixed note keys (_index 2026, _money 2026, _app rcmd, _topsight 2026) until
  // 2026-10-13: they're live now, holding those notes until re-set. P opened Spin's Raycast list
  // (raycast://extensions/sara/spin/index) from 2026-03-14 until 2026-10-13, when Featurebase's (◆F)
  // took over its projects; 6–0 were bound by nobody until that day
  "liveKeys": ["A", "B", "C", "E", "G", "H", "I", "J", "K", "L", "M", "O", "P", "Q", "R", "S", "U", "V", "X", "Y", "Z",
               "6", "7", "8", "9", "0"]
}
